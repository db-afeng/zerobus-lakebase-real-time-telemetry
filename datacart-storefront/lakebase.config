# Lakebase development defaults for the externally managed workshop project.
LAKEBASE_PROJECT_NAME="${LAKEBASE_PROJECT_NAME:-zerobus-lakebase-workshop-alex-feng}"
LAKEBASE_PARENT_BRANCH="${LAKEBASE_PARENT_BRANCH:-production}"
LAKEBASE_DATABASE="${LAKEBASE_DATABASE:-databricks_postgres}"
LAKEBASE_PROFILE="${LAKEBASE_PROFILE:-infomedia-lakebase}"
LAKEBASE_PG_ROLE="${LAKEBASE_PG_ROLE:-lakebase-app-schema-owner}"
LAKEBASE_BRANCH_TTL="${LAKEBASE_BRANCH_TTL:-21600s}"
LAKEBASE_ENDPOINT_ID="${LAKEBASE_ENDPOINT_ID:-dev}"
